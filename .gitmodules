[submodule ".registry"]
	path = .registry
	url = https://github.com/igrave/igrave.r-universe.dev
	branch = HEAD
[submodule "icsp2"]
	path = icsp2
	url = https://github.com/igrave/icsp2
[submodule "ladder"]
	path = ladder
	url = https://github.com/igrave/ladder
[submodule "ladder.api"]
	path = ladder.api
	url = https://github.com/igrave/ladder.api
